{
    "name": "@partchat/backend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "prettier": "prettier --check src",
        "prettier:fix": "prettier --write src",
        "build": "tsc",
        "dev": "nodemon --exec tsx src/server.ts | pino-pretty",
