        "dotenv": "^17.0.0",
        "fastify": "^5.4.0",
        "fastify-jwt-jwks": "^3.0.0",
        "fastify-type-provider-zod": "^6.1.0",
        "http-errors": "^2.0.0",
        "jimp": "^1.6.0",
        "lodash": "^4.17.21",
        "slugify": "^1.6.6",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/http-errors": "^2.0.1",
        "@types/lodash": "^4.14.192",
